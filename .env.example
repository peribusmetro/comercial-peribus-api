# =============================================================================
# comercial-peribus-api — validador intermedio AdminPAQ → peribus-incidents-admin
#
# Copiar a .env y completar. NUNCA commitear el .env real.
# =============================================================================

# --- Entorno ---
NODE_ENV=development
PORT=3000

# --- DB propia del validador (proyecto Supabase APARTE) ---
# Usar la URL del POOLER (puerto 6543), no la conexión directa:
# Vercel es serverless y el pooler evita agotar conexiones.
VALIDATOR_DATABASE_URL=postgresql://postgres.PROYECTO:PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# --- Supabase de peribus-incidents-admin ---
# Aquí el API escribe comercial_document_links. Todo lo demás lo lee.
APP_DATABASE_URL=postgresql://postgres.PROYECTO:PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# --- SQL Server / AdminPAQ ---
# Solo lo necesitan los pasos de ETL. Los endpoints de revisión no.
SQL_SERVER_HOST=
SQL_SERVER_PORT=1433
SQL_SERVER_USER=
SQL_SERVER_PASSWORD=
SQL_SERVER_DATABASE=adPERIBUS_METROPOLITAN

# --- Seguridad ---
# Claves de lectura/revisión, separadas por comas. Las usa la app Next.
API_KEYS=genera-una-clave-larga-aqui

# Clave EXCLUSIVA para /internal/* (la usa el cron de Supabase).
# Separada a propósito: si se filtra una clave de lectura, no debe poder
# disparar sincronizaciones ni escribir links. Mínimo 16 caracteres.
INTERNAL_API_KEY=genera-otra-clave-distinta-y-larga

# --- Comportamiento del validador ---
# audit   → detecta y reporta, NO escribe links (modo inicial)
# enforce → además aplica links y cuarentena
VALIDATOR_MODE=audit

# Días entre captura y modificación en el ERP para marcar re-ligado tardío (R4)
LATE_RELINK_DAYS=14
