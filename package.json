{
  "name": "comercial-peribus-api",
  "version": "1.0.0",
  "description": "Validador intermedio entre AdminPAQ (SQL Server) y peribus-incidents-admin",
  "author": "Eduardo Vargas",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json && npm run copy:sql",
    "copy:sql": "mkdir -p dist/src/db/migrations && cp src/db/migrations/*.sql dist/src/db/migrations/",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "check:coverage": "tsx src/cli/check-coverage.ts",
    "etl": "tsx src/cli/run-etl.ts",
    "verify:deploy": "tsx src/cli/verify-deploy.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.94.1",
    "@vercel/functions": "^3.9.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "mssql": "^11.0.1",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/mssql": "^9.1.7",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
